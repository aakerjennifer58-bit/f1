# Frontend (optional - defaults to /api/mpesa for Vercel)
VITE_API_URL=/api/mpesa

# M-Pesa Credentials (set in Vercel dashboard)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_TILL=your_till_number
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/mpesa?action=callback
MPESA_ENV=live
